@*
    Forced with [UIHint("Tags")]. Each tag is a hidden input sharing one name,
    which the model binder collects back into List<string>. The visible text box
    is deliberately unnamed so it never posts.
*@
@model IEnumerable<string>
@{
    var meta = ViewData.ModelMetadata;
    var name = ViewData.TemplateInfo.GetFullHtmlFieldName(string.Empty);
    var baseId = TagBuilder.CreateSanitizedId(name, "_");
    var tags = (Model ?? Enumerable.Empty<string>()).ToList();
}
<div class="mb-3">
    <label for="@baseId" class="form-label">@meta.GetDisplayName()</label>
    <div class="border rounded p-2" data-tags-editor data-tags-name="@name">
        <div class="mb-2" data-tag-list>
            @foreach (var tag in tags)
            {
                <span class="badge text-bg-primary d-inline-flex align-items-center gap-2 me-1 mb-1">
                    <span>@tag</span>
                    <button type="button" class="btn-close btn-close-white" data-remove-tag aria-label="Remove tag"></button>
                    <input type="hidden" name="@name" value="@tag" />
                </span>
            }
        </div>
        <input type="text" class="form-control form-control-sm border-0" id="@baseId"
               data-tag-input placeholder="Type a tag and press Enter" />
    </div>
    @if (!string.IsNullOrWhiteSpace(meta.Description))
    {
        <div class="form-text">@meta.Description</div>
    }
</div>
