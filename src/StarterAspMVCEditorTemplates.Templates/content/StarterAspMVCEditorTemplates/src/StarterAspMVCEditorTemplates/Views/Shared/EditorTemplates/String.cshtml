@*
    Resolved for any string property that has no [UIHint] and no [DataType].
    Lookup order MVC uses: [UIHint] -> [DataType] -> type name -> base types -> "Object"/"String".
*@
@model string
@{
    var meta = ViewData.ModelMetadata;
}
<div class="mb-3">
    <label asp-for="@Model" class="form-label">
        @meta.GetDisplayName()
        @if (meta.IsRequired)
        {
            <span class="text-danger">*</span>
        }
    </label>
    <input asp-for="@Model" class="form-control" placeholder="@meta.Placeholder" />
    @if (!string.IsNullOrWhiteSpace(meta.Description))
    {
        <div class="form-text">@meta.Description</div>
    }
    <span asp-validation-for="@Model" class="text-danger small"></span>
</div>
