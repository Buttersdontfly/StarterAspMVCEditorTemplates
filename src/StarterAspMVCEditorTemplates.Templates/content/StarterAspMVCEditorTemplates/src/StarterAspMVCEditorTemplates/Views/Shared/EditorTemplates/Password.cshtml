@model string

@*
    Fires on: [DataType(DataType.Password)].

    autocomplete matters here and is routinely wrong in hand-rolled Identity
    pages: password managers need "current-password" when signing in and
    "new-password" when setting one. This picks a sensible default from the
    field name, and any view can override it:

        @Html.EditorFor(m => m.Password, new { autocomplete = "new-password" })

    See EmailAddress.cshtml for why these are Html.*For helpers, not tag helpers.
*@

@{
    var fieldName = ViewData.TemplateInfo.GetFullHtmlFieldName(string.Empty);
    var errorId = $"{fieldName.Replace('.', '_').Replace('[', '_').Replace(']', '_')}_error";
    var invalid = ViewData.ModelState.GetFieldValidationState(fieldName)
        == Microsoft.AspNetCore.Mvc.ModelBinding.ModelValidationState.Invalid;

    var propertyName = ViewData.ModelMetadata.PropertyName ?? string.Empty;
    var looksNew = propertyName.Contains("New", StringComparison.OrdinalIgnoreCase)
                   || propertyName.Contains("Confirm", StringComparison.OrdinalIgnoreCase);

    var autocomplete = ViewData["autocomplete"] as string
                       ?? (looksNew ? "new-password" : "current-password");
}

<div class="mb-3">
    @Html.LabelFor(m => m, new { @class = "form-label" })
    @Html.PasswordFor(m => m, new
    {
        @class = "form-control" + (invalid ? " is-invalid" : ""),
        autocomplete = autocomplete,
        aria_describedby = errorId
    })
    @Html.ValidationMessageFor(m => m, null, new { id = errorId, @class = "invalid-feedback d-block" })
</div>
