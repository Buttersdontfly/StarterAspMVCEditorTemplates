@*
    Forced with [UIHint("Dropdown")]. The options are not baked into the
    template - the calling view hands them over as additionalViewData:

        @Html.EditorFor(m => m.CountryId, new { items = ViewData["Countries"] })

    Anything in that anonymous object lands in this template's ViewData.
*@
@model object
@{
    var meta = ViewData.ModelMetadata;
    var items = ViewData["items"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var placeholder = ViewData["placeholder"] as string ?? meta.Placeholder ?? "-- select --";
}
<div class="mb-3">
    <label asp-for="@Model" class="form-label">
        @meta.GetDisplayName()
        @if (meta.IsRequired)
        {
            <span class="text-danger">*</span>
        }
    </label>
    <select asp-for="@Model" asp-items="items" class="form-select">
        <option value="">@placeholder</option>
    </select>
    @if (!string.IsNullOrWhiteSpace(meta.Description))
    {
        <div class="form-text">@meta.Description</div>
    }
    <span asp-validation-for="@Model" class="text-danger small"></span>
</div>
