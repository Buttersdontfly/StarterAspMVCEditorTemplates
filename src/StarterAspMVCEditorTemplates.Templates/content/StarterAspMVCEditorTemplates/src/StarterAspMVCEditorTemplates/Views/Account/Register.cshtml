@model StarterAspMVCEditorTemplates.Models.Account.RegisterInputModel
@using StarterAspMVCEditorTemplates.Identity
@{
    ViewData["Title"] = "Create account";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1 class="h3 mb-3">Create an account</h1>

        <form asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            @* SEAM: username identity. The username field appears only when
               AccountIdentityConventions.SignInWithEmail is false. Flip that
               constant and this switches over -- nothing here needs editing. *@
            @if (!AccountIdentityConventions.SignInWithEmail)
            {
                @Html.EditorFor(m => m.UserName)
            }

            @Html.EditorFor(m => m.Email)
            @Html.EditorFor(m => m.Password, new { autocomplete = "new-password" })
            @Html.EditorFor(m => m.ConfirmPassword, new { autocomplete = "new-password" })

            <button type="submit" class="btn btn-primary w-100">Create account</button>
        </form>

        <p class="mt-3 small">Already have an account? <a asp-action="Login">Sign in</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
