<Project>

  <!--
    STOPPER FILE.
    This exists so the generated project does not inherit MSBuild settings from a
    parent directory if you drop it inside an existing repository. Do not add
    <Import Project="$([MSBuild]::GetPathOfFileAbove(...))" /> unless you want that.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>   
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!--
    SEAM: database provider.

    Chosen at generation time. To move to PostgreSQL, MySQL or anything else:
      1. Replace the PackageReference below.
      2. Replace the UseSqlite / UseSqlServer call in Program.cs, marked with the same SEAM tag.
      3. Delete src/StarterAspMVCEditorTemplates/Migrations/ and re-run
         `dotnet ef migrations add Initial`. Migrations are provider specific and are NOT portable.
  -->
  <ItemGroup>
<!--#if (UseSqlite) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />    
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
<!--#endif -->
<!--#if (UseSqlServer) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
<!--#endif -->
  </ItemGroup>

</Project>
