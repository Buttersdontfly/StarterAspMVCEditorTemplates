<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>StarterAspMVCEditorTemplates</PackageId>
    <Title>ASP.NET Core MVC Starter with Editor Templates</Title>
    <Description>An ASP.NET Core MVC starter template using SQLite and hand-rolled Identity pages built entirely from EditorTemplates (email, password, name, address).</Description>
    <PackageTags>dotnet-new;templates;aspnetcore;mvc;identity;editortemplates</PackageTags>

    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>

    <!--
      ContentTargetFolders is deliberately NOT set. The source folder is already
      named "content", so combining the two produced package paths beginning
      content/content/ and pushed every file 8 characters deeper. The Content
      item below sets PackagePath explicitly instead.
    -->

    <!--
      NU5128: no lib/ref assemblies, expected for a template package.
      NU5123: long paths inside the package. The template ships a full project
      tree, and the deepest vendored asset path is inherently long. It is a
      warning about consumers without long-path support, not a defect, and
      TreatWarningsAsErrors would otherwise make it fatal.
    -->
    <NoWarn>$(NoWarn);NU5128;NU5123</NoWarn>
    <NoDefaultExcludes>true</NoDefaultExcludes>

    <EnableDefaultItems>false</EnableDefaultItems>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>false</IncludeSymbols>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- PackagePath keeps the tree at content/<project>/... rather than
         content/content/<project>/... See the note above. -->
    <Content Include="content\**\*"
             Exclude="content\**\bin\**;content\**\obj\**"
             PackagePath="content\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Remove="**\*" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

</Project>
