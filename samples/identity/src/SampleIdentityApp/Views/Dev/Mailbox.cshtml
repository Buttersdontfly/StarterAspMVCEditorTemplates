@model IReadOnlyList<SampleIdentityApp.Services.SentEmail>
@{
    ViewData["Title"] = "Mailbox";
}

<h1 class="h3">Mailbox</h1>
<p class="text-muted">
    Messages the app tried to send. No email provider is configured, so nothing left
    this machine. Also written to the console and to <code>App_Data/mail/</code>.
    Development only, and cleared when the app restarts.
</p>

@if (Model.Count == 0)
{
    <div class="alert alert-secondary">
        Nothing here yet. <a asp-controller="Account" asp-action="ForgotPassword">Request a password reset</a>
        and the link will appear on this page.
    </div>
}
else
{
    <div class="list-group">
        @foreach (var message in Model)
        {
            <div class="list-group-item">
                <div class="d-flex justify-content-between">
                    <strong>@message.Subject</strong>
                    <span class="text-muted small">@message.SentAt.ToString("HH:mm:ss")</span>
                </div>
                <div class="text-muted small mb-2">To @message.To</div>
                <div class="border rounded p-2 bg-light">@Html.Raw(message.HtmlBody)</div>
            </div>
        }
    </div>
}
