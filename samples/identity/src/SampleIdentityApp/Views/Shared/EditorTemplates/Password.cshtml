@*
    Resolved by [DataType(DataType.Password)].

    autocomplete matters here and is routinely wrong in hand-rolled account
    pages: password managers need "current-password" when signing in and
    "new-password" when setting one. The default is inferred from the property
    name; override it per field:

        @Html.EditorFor(m => m.Password, new { autocomplete = "new-password" })
*@
@model string
@{
    var meta = ViewData.ModelMetadata;
    var propertyName = meta.PropertyName ?? string.Empty;
    var looksNew = propertyName.Contains("New", StringComparison.OrdinalIgnoreCase)
                   || propertyName.Contains("Confirm", StringComparison.OrdinalIgnoreCase);
    var autocomplete = ViewData["autocomplete"] as string
                       ?? (looksNew ? "new-password" : "current-password");
}
<div class="mb-3">
    <label asp-for="@Model" class="form-label">
        @meta.GetDisplayName()
        @if (meta.IsRequired)
        {
            <span class="text-danger">*</span>
        }
    </label>
    <input asp-for="@Model" type="password" class="form-control" autocomplete="@autocomplete" />
    @if (!string.IsNullOrWhiteSpace(meta.Description))
    {
        <div class="form-text">@meta.Description</div>
    }
    <span asp-validation-for="@Model" class="text-danger small"></span>
</div>
