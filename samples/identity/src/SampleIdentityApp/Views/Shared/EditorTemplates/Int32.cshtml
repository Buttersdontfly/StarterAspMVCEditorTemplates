@* Resolved on the type name for every int that has no [UIHint]/[DataType]. *@
@model int
@{
    var meta = ViewData.ModelMetadata;
    var range = meta.ValidatorMetadata.OfType<System.ComponentModel.DataAnnotations.RangeAttribute>().FirstOrDefault();
    var min = range?.Minimum?.ToString();
    var max = range?.Maximum?.ToString();
}
<div class="mb-3">
    <label asp-for="@Model" class="form-label">
        @meta.GetDisplayName()
        @if (meta.IsRequired)
        {
            <span class="text-danger">*</span>
        }
    </label>
    <input asp-for="@Model" type="number" step="1" min="@min" max="@max" class="form-control" placeholder="@meta.Placeholder" />
    @if (!string.IsNullOrWhiteSpace(meta.Description))
    {
        <div class="form-text">@meta.Description</div>
    }
    <span asp-validation-for="@Model" class="text-danger small"></span>
</div>
