@model SampleIdentityApp.Models.PersonNameInputModel

@*
    Fires on: TYPE NAME. Complex types have no DataType to resolve from, so MVC
    falls through to the model's type name — this file must stay named
    PersonNameInputModel.cshtml. Rename the class and you must rename the file.
    See documentation/editor-templates.md.

    Rendered as a fieldset so the two inputs are announced as one group.
*@

<fieldset class="mb-3">
    <legend class="form-label fs-6 mb-2">@(ViewData.ModelMetadata.DisplayName ?? "Name")</legend>
    <div class="row g-2">
        <div class="col-sm-6">
            <label asp-for="FirstName" class="form-label"></label>
            <input asp-for="FirstName" class="form-control" autocomplete="given-name"
                   aria-describedby="@Html.IdFor(m => m.FirstName)-error" />
            <span id="@Html.IdFor(m => m.FirstName)-error" asp-validation-for="FirstName" class="text-danger small"></span>
        </div>
        <div class="col-sm-6">
            <label asp-for="LastName" class="form-label"></label>
            <input asp-for="LastName" class="form-control" autocomplete="family-name"
                   aria-describedby="@Html.IdFor(m => m.LastName)-error" />
            <span id="@Html.IdFor(m => m.LastName)-error" asp-validation-for="LastName" class="text-danger small"></span>
        </div>
    </div>
</fieldset>
