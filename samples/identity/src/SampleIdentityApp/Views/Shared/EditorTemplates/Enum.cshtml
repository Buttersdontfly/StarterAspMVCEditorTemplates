@*
    "Enum" is added to the template lookup chain automatically for enum
    properties, so this file renders every enum that has no [UIHint].
    Options are generated from the enum itself, honouring [Display(Name = ...)]
    on the members.
*@
@model object
@{
    var meta = ViewData.ModelMetadata;
    var enumType = meta.UnderlyingOrModelType;
    var items = Html.GetEnumSelectList(enumType);
    var isNullable = meta.IsNullableValueType;
}
<div class="mb-3">
    <label asp-for="@Model" class="form-label">
        @meta.GetDisplayName()
        @if (meta.IsRequired)
        {
            <span class="text-danger">*</span>
        }
    </label>
    <select asp-for="@Model" asp-items="items" class="form-select">
        @if (isNullable)
        {
            <option value="">@(meta.Placeholder ?? "-- none --")</option>
        }
    </select>
    @if (!string.IsNullOrWhiteSpace(meta.Description))
    {
        <div class="form-text">@meta.Description</div>
    }
    <span asp-validation-for="@Model" class="text-danger small"></span>
</div>
