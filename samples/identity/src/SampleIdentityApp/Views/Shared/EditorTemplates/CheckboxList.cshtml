@*
    Forced with [UIHint("CheckboxList")]. Note the model here is the whole
    List<int>, not a single element - the UIHint short-circuits MVC's usual
    "render one template per item" behaviour for collections.

    Several checkboxes sharing one name post back as a list, which the default
    model binder turns straight back into List<int>.
*@
@model IEnumerable<int>
@{
    var meta = ViewData.ModelMetadata;
    var name = ViewData.TemplateInfo.GetFullHtmlFieldName(string.Empty);
    var baseId = TagBuilder.CreateSanitizedId(name, "_");
    var items = ViewData["items"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var selected = new HashSet<string>((Model ?? Enumerable.Empty<int>()).Select(v => v.ToString()));
    var columns = ViewData["columns"] as int? ?? 3;
}
<div class="mb-3">
    <label class="form-label d-block">@meta.GetDisplayName()</label>
    <div class="row row-cols-1 row-cols-md-@columns g-1">
        @{ var i = 0; }
        @foreach (var item in items)
        {
            var id = $"{baseId}_{i++}";
            <div class="col">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="@name" id="@id"
                           value="@item.Value" checked="@selected.Contains(item.Value)" />
                    <label class="form-check-label" for="@id">@item.Text</label>
                </div>
            </div>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(meta.Description))
    {
        <div class="form-text">@meta.Description</div>
    }
</div>
