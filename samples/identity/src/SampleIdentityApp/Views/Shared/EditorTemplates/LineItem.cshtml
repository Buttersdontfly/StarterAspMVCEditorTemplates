@*
    The item template for a collection. Html.EditorFor(m => m.LineItems) renders
    this once per element and supplies the index, so asp-for="Description"
    becomes name="LineItems[0].Description".

    The hidden Id keeps existing rows identifiable on the way back, which is how
    the controller tells an edit from an insert.
*@
@model SampleIdentityApp.Models.LineItem
<div class="row g-2 align-items-start border-top pt-3" data-line-item>
    <input type="hidden" asp-for="Id" />
    <div class="col-12 col-md-5">
        @Html.EditorFor(m => m.Description)
    </div>
    <div class="col-6 col-md-2">
        @Html.EditorFor(m => m.Quantity)
    </div>
    <div class="col-6 col-md-4">
        @Html.EditorFor(m => m.UnitPrice)
    </div>
    <div class="col-12 col-md-1 d-grid">
        <button type="button" class="btn btn-outline-danger btn-sm" data-remove-line-item
                title="Remove this line">Remove</button>
    </div>
</div>
