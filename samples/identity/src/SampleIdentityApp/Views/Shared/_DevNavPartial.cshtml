@*
    Development-only navigation links.

    Excluded entirely when the project is generated with --auth none, because
    the dev pages go with it. The layout renders this with optional="true", so
    its absence is not an error and the layout itself needs no conditionals.
*@

@if (Context.RequestServices.GetRequiredService<IWebHostEnvironment>().IsDevelopment())
{
    <li class="nav-item"><a class="nav-link" href="/dev/editors">Editor templates</a></li>
    <li class="nav-item"><a class="nav-link" href="/dev/mailbox">Mailbox</a></li>
}
