@model SampleIdentityApp.Models.Account.ResetPasswordInputModel
@{
    ViewData["Title"] = "Choose a new password";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1 class="h3 mb-3">Choose a new password</h1>

        <form asp-action="ResetPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <input asp-for="Token" type="hidden" />

            @Html.EditorFor(m => m.Email)
            @Html.EditorFor(m => m.Password, new { autocomplete = "new-password" })
            @Html.EditorFor(m => m.ConfirmPassword, new { autocomplete = "new-password" })

            <button type="submit" class="btn btn-primary w-100">Save new password</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
