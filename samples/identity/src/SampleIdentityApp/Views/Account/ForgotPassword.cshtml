@model SampleIdentityApp.Models.Account.ForgotPasswordInputModel
@{
    ViewData["Title"] = "Reset your password";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1 class="h3 mb-3">Reset your password</h1>
        <p>Enter your email address and we will send you a link to choose a new password.</p>

        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            @Html.EditorFor(m => m.Email)
            <button type="submit" class="btn btn-primary w-100">Send reset link</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
