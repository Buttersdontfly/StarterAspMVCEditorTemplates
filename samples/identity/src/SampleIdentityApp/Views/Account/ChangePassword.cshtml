@model SampleIdentityApp.Models.Account.ChangePasswordInputModel
@{
    ViewData["Title"] = "Change password";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1 class="h3 mb-3">Change your password</h1>

        <form asp-action="ChangePassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            @Html.EditorFor(m => m.CurrentPassword, new { autocomplete = "current-password" })
            @Html.EditorFor(m => m.NewPassword, new { autocomplete = "new-password" })
            @Html.EditorFor(m => m.ConfirmPassword, new { autocomplete = "new-password" })

            <button type="submit" class="btn btn-primary w-100">Change password</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
