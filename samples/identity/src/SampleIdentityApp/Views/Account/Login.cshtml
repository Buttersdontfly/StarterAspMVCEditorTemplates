@model SampleIdentityApp.Models.Account.LoginInputModel
@using SampleIdentityApp.Identity
@{
    ViewData["Title"] = "Sign in";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1 class="h3 mb-3">Sign in</h1>

        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            @* SEAM: username identity. Which identifier is asked for follows
               AccountIdentityConventions.SignInWithEmail. Flip that constant and
               this switches over -- nothing here needs editing. *@
            @if (AccountIdentityConventions.SignInWithEmail)
            {
                @Html.EditorFor(m => m.Email)
            }
            else
            {
                @Html.EditorFor(m => m.UserName)
            }
            @Html.EditorFor(m => m.Password, new { autocomplete = "current-password" })

            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary w-100">Sign in</button>
        </form>

        <div class="mt-3 d-flex justify-content-between small">
            <a asp-action="ForgotPassword">Forgot your password?</a>
            <a asp-action="Register">Create an account</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
