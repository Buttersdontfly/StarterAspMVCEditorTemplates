@*
    Resolved by [DataType(DataType.EmailAddress)].
    autocomplete="email" lets password managers and browsers fill it.
*@
@model string
@{
    var meta = ViewData.ModelMetadata;
}
<div class="mb-3">
    <label asp-for="@Model" class="form-label">
        @meta.GetDisplayName()
        @if (meta.IsRequired)
        {
            <span class="text-danger">*</span>
        }
    </label>
    <input asp-for="@Model" type="email" class="form-control"
           autocomplete="email" inputmode="email" spellcheck="false"
           placeholder="@(meta.Placeholder ?? "name@example.com")" />
    @if (!string.IsNullOrWhiteSpace(meta.Description))
    {
        <div class="form-text">@meta.Description</div>
    }
    <span asp-validation-for="@Model" class="text-danger small"></span>
</div>
