@*
    Forced with [UIHint("RadioGroup")]. Falls back to the enum members when the
    caller does not supply items, so it works for both enums and lookup lists:

        @Html.EditorFor(m => m.PreferredContact)
        @Html.EditorFor(m => m.CountryId, "RadioGroup", new { items = countries })

    The field name comes from TemplateInfo, which already carries the prefix of
    the property being edited (including collection indexes).
*@
@model object
@{
    var meta = ViewData.ModelMetadata;
    var name = ViewData.TemplateInfo.GetFullHtmlFieldName(string.Empty);
    var baseId = TagBuilder.CreateSanitizedId(name, "_");

    var items = ViewData["items"] as IEnumerable<SelectListItem>;
    if (items is null && meta.UnderlyingOrModelType.IsEnum)
    {
        items = Html.GetEnumSelectList(meta.UnderlyingOrModelType);
    }
    items ??= Enumerable.Empty<SelectListItem>();

    // An enum posts back as either its name or its numeric value; accept both.
    var current = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    if (Model is not null)
    {
        current.Add(Model.ToString() ?? string.Empty);
        if (meta.UnderlyingOrModelType.IsEnum)
        {
            current.Add(Convert.ToInt64(Model).ToString());
        }
    }

    var inline = ViewData["inline"] as bool? ?? true;
}
<div class="mb-3">
    <label class="form-label d-block">
        @meta.GetDisplayName()
        @if (meta.IsRequired)
        {
            <span class="text-danger">*</span>
        }
    </label>
    @{ var i = 0; }
    @foreach (var item in items)
    {
        var id = $"{baseId}_{i++}";
        <div class="form-check @(inline ? "form-check-inline" : string.Empty)">
            <input class="form-check-input" type="radio" name="@name" id="@id"
                   value="@item.Value" checked="@current.Contains(item.Value)" />
            <label class="form-check-label" for="@id">@item.Text</label>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(meta.Description))
    {
        <div class="form-text">@meta.Description</div>
    }
    <span asp-validation-for="@Model" class="text-danger small"></span>
</div>
