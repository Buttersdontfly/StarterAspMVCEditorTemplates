@*
    Resolved on the type name for bool properties. asp-for also emits the hidden
    "false" companion field, so an unchecked box still posts a value.
*@
@model bool
@{
    var meta = ViewData.ModelMetadata;
}
<div class="mb-3">
    <div class="form-check form-switch">
        <input asp-for="@Model" class="form-check-input" type="checkbox" role="switch" />
        <label asp-for="@Model" class="form-check-label">@meta.GetDisplayName()</label>
    </div>
    @if (!string.IsNullOrWhiteSpace(meta.Description))
    {
        <div class="form-text">@meta.Description</div>
    }
    <span asp-validation-for="@Model" class="text-danger small"></span>
</div>
